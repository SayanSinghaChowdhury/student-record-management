// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Target runtime environment. Default: nodejs
  // runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

//  relation  with subject stream & subject connect with teacher  
model Teacher {
  id       String    @id @default(uuid())
  fullName String
  email    String
  phNumber String
  streams  Stream[]
  subjects Subject[]
}

model Stream {
  id        String  @id @default(uuid())
  stream    String
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Subject {
  id        String  @id @default(uuid())
  subject   String
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}
